# Copy this file to pcf/.env and fill in your keys.
# pcf/.env is gitignored, so it never gets committed. Never put a real key in this example file.
# For GitHub Actions, the same names go in repo Settings → Secrets and variables → Actions.

# The Odds API (free Starter tier: 500 credits/month). Used by odds-collection for prices and TD odds.
ODDS_API_KEY=

# College Football Data API (free tier). Used later by the prospects expert.
CFBD_API_KEY=
